{
  "name": "murmur",
  "version": "0.1.4",
  "description": "Push-to-talk dictation that lives in your tray. BYOK, Windows and macOS.",
  "license": "GPL-3.0-only",
  "author": "LaBroi Walton",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/gen-icons.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-headers.js && node scripts/check-design.js && vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.js",
    "roadmap": "node scripts/roadmap.js",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "check:design": "node scripts/check-design.js",
    "check:headers": "node scripts/check-headers.js",
    "notices": "node scripts/gen-notices.js"
  },
  "build": {
    "appId": "com.lbwalton.murmur",
    "productName": "murmur",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/tray",
        "to": "icons/tray"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "murmur-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "murmur records your voice while you hold the hotkey and sends it only to the transcription provider you configured.",
        "LSUIElement": true
      },
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "lbwalton",
      "repo": "murmur"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lbwalton/murmur.git"
  },
  "homepage": "https://github.com/lbwalton/murmur#readme",
  "bugs": {
    "url": "https://github.com/lbwalton/murmur/issues"
  }
}
