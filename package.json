{
  "name": "murmur",
  "version": "0.1.0",
  "description": "Push-to-talk dictation that lives in your tray. BYOK, Windows and macOS.",
  "license": "GPL-3.0-only",
  "author": "LaBroi Walton",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/gen-icons.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.js",
    "roadmap": "node scripts/roadmap.js",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.lbwalton.murmur",
    "productName": "murmur",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
